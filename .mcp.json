{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--user-data-dir",
        ".playwright-profile",
        "--caps",
        "vision"
      ]
    },
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.5.0",
        "mcp"
      ]
    }
  }
}
